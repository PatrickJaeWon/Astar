# Internal API key — required for all admin endpoints
INTERNAL_API_KEY=your-secret-api-key-here

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# VAPI (Voice AI Platform) — for AI phone interviews
# https://dashboard.vapi.ai
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# Optional: set a secret to validate incoming VAPI webhooks
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# Public URL that VAPI can reach for webhooks
PUBLIC_BASE_URL=https://your-domain.com

# Twilio (SMS only — voice is handled by VAPI)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=recruit@yourcompany.com
SMTP_FROM_NAME=AstarCorp 채용팀
# true = TLS (port 465), false = STARTTLS (port 587)
SMTP_USE_TLS=false

# Company info
COMPANY_NAME=AstarCorp
COMPANY_EMAIL=recruit@yourcompany.com

# Database
DATABASE_URL=sqlite:///./recruitment.db
