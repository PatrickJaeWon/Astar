# Internal API key — required for all endpoints
INTERNAL_API_KEY=your-secret-api-key-here

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Public URL that Twilio can reach for voice webhooks
PUBLIC_BASE_URL=https://your-domain.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=recruit@yourcompany.com
SMTP_FROM_NAME=AstarCorp 채용팀
# true = TLS (port 465), false = STARTTLS (port 587)
SMTP_USE_TLS=false

# Company info for notifications
COMPANY_NAME=AstarCorp
COMPANY_EMAIL=recruit@yourcompany.com

# Database
DATABASE_URL=sqlite:///./recruitment.db
